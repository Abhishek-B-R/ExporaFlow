generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  ENGINEER
  QA
  VIEWER
}

enum ProjectServiceLine {
  SAP_CONSULTING
  ORACLE_CONSULTING
  MANAGED_SERVICES
  SOFTWARE_DEVELOPMENT
}

enum TicketType {
  INCIDENT
  CHANGE
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  username        String?
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Project         Project?  @relation(fields: [projectId], references: [id])
  projectId       String?
  createdProjects Project[] @relation("ProjectCreator")
  Issue           Issue[]

  workspaceMembers WorkspaceMember[]
  teamMembers      TeamMember[]
  projectMembers   ProjectMember[]
  issueComments    IssueComment[]
  mentionsReceived CommentMention[]
  notifications    Notification[]
  issueActivities  IssueActivity[]
  savedViews       SavedView[]
  invitationsSent  Invitation[]     @relation("InvitationSender")
  serviceLineGrants UserServiceLineGrant[]
  employee          Employee?
  managedTeams      Team[]              @relation("TeamManager")
  requestedIssues   Issue[]             @relation("IssueRequester")
  issueAttachments  IssueAttachment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WaitListEmails {
  id    String @id @default(uuid())
  email String @unique
}

model Customer {
  id                 String    @id @default(uuid())
  name               String
  organizationName String
  address            String?
  email              String?
  phoneNumber        String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  projects           Project[]
}

model Employee {
  id                  String   @id @default(cuid())
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String
  email               String   @unique
  phoneNumber         String?
  designation         String?
  role                Role     @default(ENGINEER)
  /// Workspace IDs this employee record is associated with (directory / access hints).
  organizationAccess  Json?
  teamId              String?
  team                  Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserServiceLineGrant {
  id          String             @id @default(cuid())
  userId      String
  serviceLine ProjectServiceLine
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceLine])
}

model Project {
  id          String    @id @default(uuid())
  title       String    @unique
  description String?
  content     String?
  health      String?
  priority    String?
  /// Primary company service for this engagement (set at project creation).
  serviceLine ProjectServiceLine?
  lead        String?
  startDate   DateTime?
  targetDate  DateTime?
  status      String?
  member      User[]
  issues      Issue[]
  creator     User      @relation("ProjectCreator", fields: [createdBy], references: [id])
  createdBy   String

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workspaceId String?

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?

  projectMembers ProjectMember[]
  sprints        Sprint[]
  notifications  Notification[]
  savedViews     SavedView[]

  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId String?
}

model Issue {
  id           String   @id @default(uuid())
  /// Per-project sequence (displayed as INC-42 / CHG-42).
  ticketNumber Int      @default(0)
  title        String
  description  String?
  status       String?
  priority     String?
  urgency      TicketUrgency @default(MEDIUM)
  requesterName String?
  requesterUser User?   @relation("IssueRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterUserId String?
  update       String?
  ticketType   TicketType @default(INCIDENT)
  User         User?    @relation(fields: [assignedUser], references: [id])
  assignedUser String?
  labels       String[] @default([])
  dueDate      DateTime?
  startDate    DateTime?
  endDate      DateTime?
  /// Planned duration in minutes (optional; used when end date not fixed).
  durationMinutes Int?
  /// When status entered Hold (CHANGE tickets); SLA clock pauses while set.
  holdStartedAt DateTime?
  /// Total seconds spent on Hold (accumulated across visits).
  accumulatedHoldSeconds Int @default(0)
  /// Absolute SLA deadline in UTC; extended when leaving Hold.
  slaDueAt     DateTime?
  Project      Project  @relation(fields: [projectId], references: [id])
  projectId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentIssue   Issue?   @relation("IssueSubtasks", fields: [parentIssueId], references: [id], onDelete: Cascade)
  parentIssueId String?
  subtasks      Issue[]  @relation("IssueSubtasks")

  blockersFrom IssueBlocker[] @relation("IssueBlocks")
  blockedBy    IssueBlocker[] @relation("IssueBlockedBy")

  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintId String?
  estimate Int?
  comments IssueComment[]
  activities IssueActivity[]
  notifications Notification[]
  attachments IssueAttachment[]

  @@unique([projectId, ticketNumber])
}

model IssueAttachment {
  id           String   @id @default(uuid())
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId      String

  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedById String
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  teams       Team[]
  projects    Project[]
  invitations Invitation[]
  labels      Label[]
}

model Label {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#6f86ff")
  description String?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([workspaceId, name])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  role        Role      @default(ADMIN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([workspaceId, userId])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  managerId   String?
  manager     User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  /// Primary practice area for this team (e.g. SAP consulting).
  serviceLine ProjectServiceLine?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  members   TeamMember[]
  projects  Project[]
  employees Employee[]

  @@unique([workspaceId, name])
}

model TeamMember {
  id        String   @id @default(uuid())
  role      Role     @default(ENGINEER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([teamId, userId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  role      Role     @default(ENGINEER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([projectId, userId])
}

model IssueBlocker {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  blocks      Issue    @relation("IssueBlocks", fields: [blocksId], references: [id], onDelete: Cascade)
  blocksId    String

  blockedBy   Issue    @relation("IssueBlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)
  blockedById String

  @@unique([blocksId, blockedById])
}

model Sprint {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("Planned") // Planned | Active | Closed
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  issues Issue[]

  @@unique([projectId, name])
}

model IssueComment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  mentions CommentMention[]
}

model CommentMention {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  comment   IssueComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String

  user   User   @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionedUserId String

  @@unique([commentId, mentionedUserId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId String?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
}

model IssueActivity {
  id        String   @id @default(uuid())
  action    String
  field     String?
  fromValue String?
  toValue   String?
  meta      Json?
  createdAt DateTime @default(now())

  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  issueId String

  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId String
}

model SavedView {
  id          String   @id @default(uuid())
  name        String
  description String?
  filters     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
}

model Invitation {
  id          String   @id @default(uuid())
  email       String
  token       String   @unique
  role        Role     @default(ENGINEER)
  status      String   @default("pending") // pending | accepted | expired
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById String

  @@index([token])
  @@index([email, workspaceId])
}
